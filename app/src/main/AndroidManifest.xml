<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the long-press menu open the system uninstall dialog (install-time, no prompt). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- For the optional "black wallpaper" setting (install-time, no prompt). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Swipe down on home opens the notification shade (install-time, no prompt). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Time limits: foreground time per app today. Granted by the user under "Nutzungsdatenzugriff". -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: every app with a launcher entry, plus other home apps
         so SetupActivity can tell whether Birdy is the default. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Birdy"
        android:theme="@style/Theme.Birdy">

        <!-- Own task affinity, so the singleTask home activity never lands inside this task. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:taskAffinity="birdy.minimal.setup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Time limits settings page: all apps with limits and strict mode. -->
        <activity
            android:name=".LimitsActivity"
            android:exported="false" />

        <!-- Edits the time limits of one app. -->
        <activity
            android:name=".LimitActivity"
            android:exported="false" />

        <!-- Covers a blocked app; own task, so leaving it never returns into the app. -->
        <activity
            android:name=".BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="birdy.minimal.block" />

        <!-- Asks how long a visit should be; same task as the block screen. -->
        <activity
            android:name=".SessionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="birdy.minimal.block" />

        <!-- Strict mode for time limits: sees which app comes to the front (see res/xml/block_service.xml). -->
        <service
            android:name=".BlockService"
            android:exported="true"
            android:label="@string/block_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/block_service" />
        </service>
    </application>
</manifest>
