<?xml version="1.0" encoding="utf-8"?>
<!-- Dark rounded tile for a choice, e.g. a session length; lightens while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_pressed="true">
        <shape><solid android:color="#262626" /><corners android:radius="24dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#141414" /><corners android:radius="24dp" /></shape>
    </item>
</selector>
