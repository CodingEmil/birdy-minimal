<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pure #000 so OLED pixels stay off. Bar colors only matter below Android 15 (edge-to-edge there). -->
    <style name="Theme.Birdy" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 400"</item>
        <item name="android:popupMenuStyle">@style/Birdy.Popup</item>
        <item name="android:textAppearanceLargePopupMenu">@style/Birdy.PopupText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/Birdy.PopupText</item>
        <item name="android:alertDialogTheme">@style/Birdy.Dialog</item>
    </style>

    <style name="Birdy.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:colorAccent">@android:color/white</item>
    </style>

    <!-- Small grey caps label above a section. -->
    <style name="Birdy.Eyebrow" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">40dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:fontVariationSettings">"'wght' 500"</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#8C8C8C</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- One point of a list; wrapped lines stay tight, points get air between them. -->
    <style name="Birdy.Line" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontVariationSettings">"'wght' 350"</item>
        <item name="android:fontFeatureSettings">tnum</item> <!-- equal-width digits, so numbered lines align -->
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Grey explanation under a setting. -->
    <style name="Birdy.Hint" parent="Birdy.Line">
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:textColor">#8C8C8C</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Settings sub-pages: big thin page name under the "Einstellungen" eyebrow. -->
    <style name="Birdy.PageTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">-2dp</item>
        <item name="android:fontVariationSettings">"'wght' 250"</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">48sp</item>
    </style>

    <!-- A row that opens something: white, dims while pressed, ends with an arrow in its text. -->
    <style name="Birdy.Link" parent="Birdy.Line">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/item_text</item>
    </style>

    <!-- Time limit screens (asking how long, blocked): clock badge, big thin app name, white button at the bottom. -->
    <style name="Birdy.Badge" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/circle</item>
        <item name="android:padding">16dp</item>
        <item name="android:src">@drawable/ic_time</item>
        <item name="android:tint">#B3B3B3</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Birdy.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">-2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:fontVariationSettings">"'wght' 250"</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">44sp</item>
    </style>

    <style name="Birdy.Button" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/button</item>
        <item name="android:fontVariationSettings">"'wght' 500"</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Birdy.Popup" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/popup</item>
    </style>

    <style name="Birdy.PopupText" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
</resources>
