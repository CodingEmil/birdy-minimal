<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Home: clock in the top half, favorites from the middle down, two icons at the bottom. -->
    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="56dp">

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.18"
                android:textAllCaps="true"
                android:textColor="#8C8C8C"
                android:textSize="13sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="4dp"
                android:fontVariationSettings="'wght' 250"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:textColor="@android:color/white"
                android:textSize="120sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="-30dp"
                android:fontVariationSettings="'wght' 250"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:textColor="#5E5E5E"
                android:textSize="120sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Scrolls only when an open group does not fit; otherwise vertical swipes belong to the drawer. -->
            <ScrollView
                android:id="@+id/favorites_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fadingEdgeLength="48dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/favorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontVariationSettings="'wght' 350"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="32dp"
                android:text="Hochwischen für alle Apps.\nLange drücken, um eine App hier anzuheften\noder in eine Gruppe zu legen."
                android:textColor="#8C8C8C"
                android:textSize="15sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="28dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/left"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/circle"
                android:visibility="invisible" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/right"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/circle"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Drawer: fades and rises over home. Clickable so taps never fall through to home. -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="invisible">

        <!-- Contacts and web search while searching, on the side away from the app results (filled in code). -->
        <LinearLayout
            android:id="@+id/suggestions_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:fadingEdgeLength="72dp"
                android:listSelector="@android:color/transparent"
                android:overScrollMode="never"
                android:paddingVertical="24dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none" />

            <!-- Sits inside the rows' 32dp right padding, so it never covers a name. Not clickable: touches reach the list. -->
            <dev.birdy.minimal.DotScrollbar
                android:id="@+id/rail"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:paddingVertical="40dp"
                android:visibility="invisible" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/suggestions_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/pill"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:drawableTint="#8C8C8C"
            android:hint="Suchen"
            android:imeOptions="actionGo"
            android:inputType="text|textNoSuggestions"
            android:paddingHorizontal="20dp"
            android:textColor="@android:color/white"
            android:textColorHint="#6B6B6B"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
