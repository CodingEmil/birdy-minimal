<?xml version="1.0" encoding="utf-8"?>
<!-- The Birdy app: whether Birdy is the home app, then one row per settings page. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="56dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/status"
            style="@style/Birdy.Eyebrow"
            android:layout_marginTop="0dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:fontVariationSettings="'wght' 250"
            android:text="Birdy"
            android:textColor="@android:color/white"
            android:textSize="64sp" />

        <!-- Only until Birdy is the home app. -->
        <LinearLayout
            android:id="@+id/onboarding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Birdy.Line"
                android:layout_marginTop="16dp"
                android:text="Birdy ist ein Launcher: Er ersetzt deinen Startbildschirm. Deshalb stellst du ihn in den Einstellungen als Startbildschirm-App ein."
                android:textColor="#B3B3B3" />

            <TextView
                style="@style/Birdy.Eyebrow"
                android:text="So wechselst du" />

            <TextView
                style="@style/Birdy.Line"
                android:text="1.  Tippe unten auf den Button." />

            <TextView
                style="@style/Birdy.Line"
                android:text="2.  Wähle Birdy als Startbildschirm-App." />

            <TextView
                style="@style/Birdy.Line"
                android:text="3.  Drück die Home-Taste. Fertig." />
        </LinearLayout>

        <TextView
            style="@style/Birdy.Eyebrow"
            android:text="Einstellungen" />

        <TextView
            android:id="@+id/setup_home"
            style="@style/Birdy.Link"
            android:text="Startbildschirm  →" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Temperatur, Hintergrund und Herunterwischen." />

        <TextView
            android:id="@+id/setup_list"
            style="@style/Birdy.Link"
            android:text="Apps &amp; Suche  →" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Sortierung der App-Liste, Tastatur, Kontakte und Websuche." />

        <TextView
            style="@style/Birdy.Eyebrow"
            android:text="Weniger am Handy" />

        <TextView
            android:id="@+id/setup_limits"
            style="@style/Birdy.Link"
            android:text="Zeitlimits  →" />

        <TextView
            android:id="@+id/setup_limits_summary"
            style="@style/Birdy.Hint" />

        <TextView
            android:id="@+id/setup_feeds"
            style="@style/Birdy.Link"
            android:text="Shorts &amp; Reels  →" />

        <TextView
            android:id="@+id/setup_feeds_summary"
            style="@style/Birdy.Hint" />

        <TextView
            style="@style/Birdy.Eyebrow"
            android:text="Hilfe" />

        <TextView
            android:id="@+id/setup_help"
            style="@style/Birdy.Link"
            android:text="Bedienung  →" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Wischen, lange drücken und Gruppen." />

        <TextView
            android:id="@+id/privacy"
            style="@style/Birdy.Link"
            android:text="Datenschutz  →" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Birdy sammelt nichts und sendet nichts. Alle Einstellungen und Zeiten bleiben auf diesem Gerät." />

        <TextView
            android:id="@+id/whatsnew"
            style="@style/Birdy.Link"
            android:text="Versionshinweise  →" />

        <TextView
            android:id="@+id/version"
            style="@style/Birdy.Hint" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <Button
            android:id="@+id/action"
            style="@style/Birdy.Button" />
    </LinearLayout>
</ScrollView>
