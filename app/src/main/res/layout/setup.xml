<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="56dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/status"
            style="@style/Birdy.Eyebrow"
            android:layout_marginTop="0dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:fontVariationSettings="'wght' 250"
            android:text="Birdy"
            android:textColor="@android:color/white"
            android:textSize="64sp" />

        <TextView
            style="@style/Birdy.Line"
            android:layout_marginTop="16dp"
            android:text="Birdy ist ein Launcher: Er ersetzt deinen Startbildschirm. Deshalb stellst du ihn in den Einstellungen als Startbildschirm-App ein."
            android:textColor="#B3B3B3" />

        <TextView
            style="@style/Birdy.Eyebrow"
            android:text="So wechselst du" />

        <TextView
            style="@style/Birdy.Line"
            android:text="1.  Tippe unten auf den Button." />

        <TextView
            style="@style/Birdy.Line"
            android:text="2.  Wähle Birdy als Startbildschirm-App." />

        <TextView
            style="@style/Birdy.Line"
            android:text="3.  Drück die Home-Taste. Fertig." />

        <TextView
            style="@style/Birdy.Eyebrow"
            android:text="So bedienst du Birdy" />

        <TextView
            style="@style/Birdy.Line"
            android:text="Hochwischen öffnet alle Apps, Herunterwischen die Benachrichtigungen." />

        <TextView
            style="@style/Birdy.Line"
            android:text="Lange drücken heftet eine App an oder legt sie unten in eine Ecke." />

        <TextView
            style="@style/Birdy.Line"
            android:text="Gruppen: lange auf eine App drücken, dann „Zu Gruppe hinzufügen“. Tippen klappt eine Gruppe auf, lange drücken bearbeitet sie." />

        <TextView
            style="@style/Birdy.Line"
            android:text="Zurückwechseln geht jederzeit hier." />

        <TextView
            style="@style/Birdy.Eyebrow"
            android:text="Einstellungen" />

        <Switch
            android:id="@+id/top_apps"
            style="@style/Birdy.Line"
            android:minHeight="48dp"
            android:text="Oft genutzte Apps oben" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Zeigt über allen Apps die 5, die du in den letzten 3 Tagen am häufigsten über Birdy geöffnet hast. Gezählt wird nur, solange das an ist, und nur auf diesem Gerät." />

        <Switch
            android:id="@+id/newest"
            style="@style/Birdy.Line"
            android:minHeight="48dp"
            android:text="Neu installierte Apps zuerst" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Sortiert die Liste nach Installationsdatum statt alphabetisch." />

        <Switch
            android:id="@+id/type"
            style="@style/Birdy.Line"
            android:minHeight="48dp"
            android:text="Beim Hochwischen gleich tippen" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Öffnet mit der App-Liste direkt die Tastatur, sodass du sofort suchen kannst." />

        <Switch
            android:id="@+id/bottom"
            style="@style/Birdy.Line"
            android:minHeight="48dp"
            android:text="Suchtreffer unten" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Treffer stehen beim Suchen unten über dem Suchfeld, der beste ganz unten. So erreichst du sie gut mit dem Daumen." />

        <Switch
            android:id="@+id/contacts"
            style="@style/Birdy.Line"
            android:minHeight="48dp"
            android:text="Kontakte in der Suche" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Beim Suchen erscheinen passende Kontakte, auf der anderen Seite als die Apps. Antippen öffnet den Kontakt. Braucht Zugriff auf deine Kontakte; Birdy liest sie nur auf dem Gerät und speichert nichts." />

        <Switch
            android:id="@+id/web"
            style="@style/Birdy.Line"
            android:minHeight="48dp"
            android:text="Websuche, wenn nichts passt" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Findet die Suche weder App noch Kontakt, sucht Enter den Begriff in Chrome, ohne Chrome im Standardbrowser." />

        <Switch
            android:id="@+id/shade"
            style="@style/Birdy.Line"
            android:minHeight="48dp"
            android:text="Herunterwischen für Benachrichtigungen" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Auf dem Startscreen nach unten wischen öffnet die Benachrichtigungen, wie beim Wischen vom oberen Rand." />

        <TextView
            android:id="@+id/setup_limits"
            style="@style/Birdy.Line"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="Zeitlimits  →"
            android:textColor="@color/item_text" />

        <TextView
            android:id="@+id/setup_limits_summary"
            style="@style/Birdy.Hint" />

        <TextView
            android:id="@+id/black_wallpaper"
            style="@style/Birdy.Line"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="Hintergrund schwarz machen  →"
            android:textColor="@color/item_text" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Die App-Übersicht kommt vom System und zeigt dessen Hintergrundbild. In Schwarz geht sie nahtlos in Birdy über. Der Sperrbildschirm bleibt, wie er ist." />


        <TextView
            android:id="@+id/privacy"
            style="@style/Birdy.Line"
            android:layout_marginTop="32dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="Datenschutz  →"
            android:textColor="@color/item_text" />

        <TextView
            style="@style/Birdy.Hint"
            android:text="Birdy sammelt nichts und sendet nichts. Alle Einstellungen und Zeiten bleiben auf diesem Gerät." />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <Button
            android:id="@+id/action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button"
            android:fontVariationSettings="'wght' 500"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@android:color/black"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
