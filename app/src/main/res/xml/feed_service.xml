<?xml version="1.0" encoding="utf-8"?>
<!-- Shorts & Reels: only YouTube and Instagram, and only their view ids (flagReportViewIds), to recognise the
     full-screen short-video player. No text is read; the one action is Back (or Home). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/feed_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="150"
    android:packageNames="com.google.android.youtube,com.instagram.android" />
